# Copy this file to `.env` and fill in your real keys.
# Do NOT commit `.env` itself — it's in .gitignore.

# Anthropic API — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Voyage AI for embeddings — https://dashboard.voyageai.com
VOYAGE_API_KEY=

# Jira Cloud — https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Set to true once Jira credentials are configured
USE_REAL_MCP=true